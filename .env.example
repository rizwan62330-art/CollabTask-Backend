# Copy this file to .env and adjust as needed.

# Port the HTTP server listens on.
PORT=4000

# Environment: development | production | test
NODE_ENV=development

# Secret used to sign JWT access tokens. Generate a real random value for
# anything beyond local development, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=1h

# Where the SQLite database file lives. Use ":memory:" for an ephemeral
# database (mainly used automatically by the test suite).
DATABASE_PATH=./data/collabtask.sqlite

# Comma-free single origin allowed to call the API from a browser (e.g. the
# Week 2 front end's dev server). Use "*" to allow any origin (fine for
# local development, not recommended in production).
CORS_ORIGIN=*
